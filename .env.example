# Seal-Agent Configuration
# Copy this file to .env and fill in your values

# Anthropic API
SEAL_ANTHROPIC_API_KEY=sk-ant-your-key-here
SEAL_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Database
SEAL_DATABASE_URL=postgresql+asyncpg://seal:seal@localhost:5432/seal_agent

# Redis
SEAL_REDIS_URL=redis://localhost:6379/0

# API
SEAL_API_HOST=0.0.0.0
SEAL_API_PORT=8000
SEAL_API_SECRET_KEY=change-me-in-production

# Application
SEAL_DEBUG=false
SEAL_LOG_LEVEL=INFO
SEAL_HEARTBEAT_ENABLED=true
